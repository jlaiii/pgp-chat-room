{
  "port": 8788,
  "bind": "127.0.0.1",
  "publicDir": "public",
  "dataDir": "data",
  "trustProxy": true,
  "retentionHours": 48,
  "cleanupMinutes": 1,
  "maxPool": 500,
  "maxMsgBytes": 131072,
  "maxFileBytes": 8388608,
  "maxFilesPerRoom": 2000,
  "maxRecipients": 300,
  "maxKeyBytes": 8192,
  "historyLimit": 400,
  "auth": {
    "scryptN": 16384
  },
  "rate": {
    "msgsPerMin": 25,
    "keysPerMin": 8,
    "connsPerMin": 40,
    "authPerMin": 10,
    "guestPerMin": 10,
    "filesPerMin": 10
  },
  "publicUrl": "https://chat.example.com/"
}
